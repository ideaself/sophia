{
  "name": "sophia",
  "version": "0.1.0",
  "description": "Sophia: 苏格拉底式启发学习伙伴（本地优先）",
  "author": "Sophia",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "build": {
    "appId": "com.sophia.app",
    "productName": "Sophia",
    "artifactName": "${productName}-${version}-Setup.${ext}",
    "electronLanguages": [
      "en-US",
      "zh-CN"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "reference/**/*"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Sophia",
      "deleteAppDataOnUninstall": false
    }
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:win": "npm run build && electron-builder --win",
    "preview": "electron-vite preview",
    "clean": "node scripts/clean.mjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:security": "node scripts/verify-security.mjs",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test": "npm run typecheck && npm run lint && npm run test:unit && npm run test:security"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "epub": "^2.1.1",
    "extract-zip": "^2.0.1",
    "katex": "^0.18.1",
    "unpdf": "^1.8.0",
    "webdav": "^5.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "^1.0.2",
    "@tailwindcss/postcss": "^4.3.2",
    "@tanstack/react-virtual": "^3.14.9",
    "@types/archiver": "^8.0.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^4.1.10",
    "dompurify": "^3.4.12",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "mermaid": "^11.16.0",
    "pdfjs-dist": "^6.1.200",
    "postcss": "^8.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.1.6",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.66.0",
    "unzipper": "^0.12.5",
    "vite": "^6.3.5",
    "vitest": "^4.1.10",
    "zustand": "^5.0.14"
  }
}
